{
  "name": "LaTeX Beamer Dev Container",
  "build": {
    "dockerfile": "dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "James-Yu.latex-workshop"
      ]
    }
  },
  "postCreateCommand": "latexmk -g -lualatex -interaction=nonstopmode -file-line-error test.tex",
  "remoteUser": "vscode"
}
